# =============================================================================
# Sistema Inteligente de Gestion y Analisis Documental - Configuracion
# Copie este archivo como .env y ajuste los valores. NUNCA versione el .env real.
# =============================================================================

# --- Aplicacion ---
APP_ENV=development
DEBUG=false

# --- Seguridad ---
# Genere un secreto fuerte:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIE_ESTE_VALOR_por_un_secreto_aleatorio_largo
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos ---
# SQLite (desarrollo, por defecto si se omite):
#   sqlite:///./database/docuintel.db
# PostgreSQL (produccion con docker-compose):
#   postgresql+psycopg2://docuintel:docuintel@db:5432/docuintel
# DATABASE_URL=sqlite:///./database/docuintel.db

# --- Almacenamiento de archivos ---
STORAGE_BACKEND=local
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# --- Worker de procesamiento ---
WORKER_EMBEDDED=true
WORKER_POLL_SECONDS=1.0
JOB_MAX_ATTEMPTS=3

# --- Proveedor de IA ---
# deterministic : reglas y embeddings hash, 100% offline y reproducible
# openai        : cualquier API compatible con OpenAI (OpenAI, Groq, Together...)
# ollama        : modelos locales via Ollama
AI_PROVIDER=deterministic

# Para AI_PROVIDER=openai:
# OPENAI_API_KEY=sk-...   (NUNCA la publique en el repositorio)
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIM=384

# Para AI_PROVIDER=ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- RAG ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.15

# --- Usuarios iniciales (solo usados por el script de seed) ---
SEED_ADMIN_EMAIL=admin@docuintel.co
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=usuario@docuintel.co
SEED_USER_PASSWORD=Usuario123!
